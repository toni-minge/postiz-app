# Postiz Production Configuration for Coolify
# Copy this file and modify for your production environment

# === Database Configuration (use Coolify's PostgreSQL service)
DATABASE_URL="postgresql://username:password@postgres-host:5432/database-name"

# === Redis Configuration (use Coolify's Redis service) 
REDIS_URL="redis://redis-host:6379"

# === JWT Secret (generate a strong random key)
JWT_SECRET="your-super-secret-jwt-key-for-production-make-it-long-and-random"

# === Frontend URLs (replace with your Coolify domain)
FRONTEND_URL="https://your-domain.com"
NEXT_PUBLIC_BACKEND_URL="https://your-domain.com"
BACKEND_INTERNAL_URL="http://localhost:3000"
MAIN_URL="https://your-domain.com"

# === S3 Storage Configuration
STORAGE_PROVIDER="s3"

# Hetzner S3 Configuration
AWS_REGION="hel1"
AWS_ACCESS_KEY_ID="your-hetzner-access-key-id"
AWS_SECRET_ACCESS_KEY="your-hetzner-secret-access-key"
AWS_S3_BUCKET="your-production-bucket-name"
AWS_S3_BUCKET_URL="https://your-production-bucket-name.hel1.your-objectstorage.com"
AWS_S3_ENDPOINT="https://hel1.your-objectstorage.com"

# === Application Settings
UPLOAD_DIRECTORY="/tmp/uploads"
IS_GENERAL="true"
DISABLE_REGISTRATION="false"

# === Email Configuration (use Resend for production)
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM_ADDRESS="noreply@your-domain.com"
EMAIL_FROM_NAME="Your App Name"

# === Optional: Telegram Bot
TELEGRAM_BOT_NAME="your_bot"
TELEGRAM_TOKEN="your-telegram-token"

# === Security
NOT_SECURED="false"
